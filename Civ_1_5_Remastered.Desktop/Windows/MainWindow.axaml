<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Civ_1_5_Remastered.Desktop.Windows.MainWindow"
        Title="Civ 1.5 Remastered"
        Background="Black"
        Width="640" Height="424"
        WindowState="Maximized"
        CanResize="True">

    <Grid>
        <DockPanel LastChildFill="True">
            <Menu DockPanel.Dock="Top" Background="#1E1E1E">
                <MenuItem Header="_View">
                    <MenuItem Header="1x (320 x 200)" Tag="1" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="2x (640 x 400)" Tag="2" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="3x (960 x 600)" Tag="3" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="4x (1280 x 800)" Tag="4" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="5x (1600 x 1000)" Tag="5" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="6x (1920 x 1200)" Tag="6" Click="OnScaleMenuItemClicked" />
                    <Separator />
                    <MenuItem Header="Maximized Window" Tag="-1" Click="OnScaleMenuItemClicked" />
                    <MenuItem Header="Full Screen (F11 / Alt+Enter)" Tag="0" Click="OnScaleMenuItemClicked" />
                </MenuItem>
            </Menu>

            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Image x:Name="ScreenImage"
                       Width="320" Height="200"
                       RenderOptions.BitmapInterpolationMode="None"
                       PointerMoved="OnScreenPointerMoved"
                       PointerPressed="OnScreenPointerPressed"
                       PointerReleased="OnScreenPointerReleased" />
            </Viewbox>
        </DockPanel>

        <Border x:Name="ExitConfirmOverlay"
                Background="#AA000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#252526"
                    BorderBrush="#007ACC"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel Spacing="16">
                    <TextBlock Text="Exit Game"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Are you sure you want to quit?"
                               FontSize="14"
                               Foreground="#CCCCCC"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <Button Content="Yes, Exit"
                                Background="#C42B1C"
                                Foreground="White"
                                Padding="16,8"
                                FontWeight="SemiBold"
                                Click="OnConfirmExitClicked" />
                        <Button Content="Cancel"
                                Background="#3A3A3C"
                                Foreground="White"
                                Padding="16,8"
                                Click="OnCancelExitClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
