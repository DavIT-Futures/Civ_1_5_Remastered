<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The game frozen at the end of the asm -> C# migration (git tag migration-end): Core, Machine, GameModel, Foundation,
    Imaging and Acoustics of that commit in one assembly, the namespace Civilization1Remaster renamed Civilization1Original.
    The tests run it next to the current game as the reference of the behaviour. Never edit it: take a new copy instead.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Civilization1Original</RootNamespace>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS8618;IDE0005</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Core\Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Core\Properties\Resources.resx">
      <LogicalName>Civilization1Original.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
