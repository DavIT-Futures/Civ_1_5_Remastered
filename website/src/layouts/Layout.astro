---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '');

const navigation = [
  { href: '/', label: 'Home' },
  { href: '/whats-new/', label: "What's new" },
  { href: '/get-started/', label: 'Get started' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/plans/', label: 'Plans' },
];

const isCurrent = (href: string) => `${base}${href}`.replace(/\/$/, '') === current;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <title>{title === 'Civ 1.5 Remastered' ? title : `${title} · Civ 1.5 Remastered`}</title>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="brand" href={`${base}/`}>Civ 1.5 <span>Remastered</span></a>
        <nav aria-label="Main">
          <ul>
            {
              navigation.map((item) => (
                <li>
                  <a href={`${base}${item.href}`} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <p>
          Civ 1.5 Remastered is an unofficial fan project, not affiliated with or endorsed by MicroProse, Firaxis Games
          or Take-Two Interactive. Civilization is a trademark of its owners. No files of the original game are part of
          this project.
        </p>
        <p>
          <a href={`${base}/translation-fixes/`}>Fixes of the translated code</a>
        </p>
      </div>
    </footer>
  </body>
</html>
