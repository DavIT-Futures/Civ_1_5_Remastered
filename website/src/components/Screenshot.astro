---
interface Props {
  name: string;
  caption: string;
  image?: string;
  smooth?: boolean;
}

const { name, caption, image, smooth = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="screenshot">
  {
    image ? (
      <img
        src={`${base}/screens/${image}`}
        alt={caption}
        loading="lazy"
        width="640"
        height="400"
        class={smooth ? 'smooth' : undefined}
      />
    ) : (
      <div class="screenshot-placeholder" role="img" aria-label={`Screenshot to come: ${caption}`}>
        <span class="screenshot-label">Screenshot</span>
        <code>public/screens/{name}.png</code>
      </div>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>
