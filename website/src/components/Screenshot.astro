---
interface Props {
  name: string;
  caption: string;
  image?: string;
}

const { name, caption, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="screenshot">
  {
    image ? (
      <img src={`${base}/screens/${image}`} alt={caption} loading="lazy" width="640" height="400" />
    ) : (
      <div class="screenshot-placeholder" role="img" aria-label={`Screenshot to come: ${caption}`}>
        <span class="screenshot-label">Screenshot</span>
        <code>public/screens/{name}.png</code>
      </div>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>
