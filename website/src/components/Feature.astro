---
import Screenshot from './Screenshot.astro';

interface Props {
  id: string;
  title: string;
  caption?: string;
  image?: string;
  secondCaption?: string;
  secondImage?: string;
}

const { id, title, caption, image, secondCaption, secondImage } = Astro.props;
---

<section class="feature" id={id}>
  <div class="feature-text">
    <h3>{title}</h3>
    <slot />
  </div>
  {
    caption && (
      <div class="feature-shots">
        <Screenshot name={id} caption={caption} image={image} />
        {secondCaption && <Screenshot name={`${id}-second`} caption={secondCaption} image={secondImage} />}
      </div>
    )
  }
</section>
