---
// Lightbox component: displays an enlarged view of screenshots with next/prev arrows
---

<div
  id="site-lightbox"
  class="lightbox-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Image preview"
  style="display: none;"
>
  <div class="lightbox-backdrop" data-action="close"></div>

  <button
    type="button"
    class="lightbox-nav-btn lightbox-close"
    data-action="close"
    aria-label="Close image preview (Escape)"
    title="Close (Esc)"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <button
    type="button"
    class="lightbox-nav-btn lightbox-prev"
    data-action="prev"
    aria-label="Previous image (Left Arrow)"
    title="Previous (Left Arrow)"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <div class="lightbox-dialog-body">
    <div class="lightbox-stage">
      <img id="lightbox-main-img" class="lightbox-main-img" src="" alt="" />
    </div>
    <div class="lightbox-info-bar">
      <p id="lightbox-caption-text" class="lightbox-caption-text"></p>
      <span id="lightbox-counter-badge" class="lightbox-counter-badge"></span>
    </div>
  </div>

  <button
    type="button"
    class="lightbox-nav-btn lightbox-next"
    data-action="next"
    aria-label="Next image (Right Arrow)"
    title="Next (Right Arrow)"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<script>
  function setupLightbox() {
    const modal = document.getElementById('site-lightbox');
    if (!modal) return;

    const img = document.getElementById('lightbox-main-img') as HTMLImageElement | null;
    const captionEl = document.getElementById('lightbox-caption-text');
    const counterEl = document.getElementById('lightbox-counter-badge');
    const prevBtn = modal.querySelector('.lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = modal.querySelector('.lightbox-next') as HTMLButtonElement | null;

    if (!img || !captionEl || !counterEl) return;

    let gallery: Array<{ src: string; caption: string; alt: string }> = [];
    let currentIndex = 0;
    let isOpen = false;

    function refreshTriggers() {
      const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));
      gallery = triggers
        .map((el) => ({
          src: el.getAttribute('data-src') || '',
          caption: el.getAttribute('data-caption') || '',
          alt: el.querySelector('img')?.getAttribute('alt') || '',
        }))
        .filter((item) => !!item.src);

      triggers.forEach((trigger, idx) => {
        trigger.onclick = (e) => {
          e.preventDefault();
          openAt(idx);
        };
        trigger.onkeydown = (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openAt(idx);
          }
        };
      });
    }

    function openAt(index: number) {
      if (gallery.length === 0) return;
      currentIndex = (index + gallery.length) % gallery.length;
      updateDisplay();
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      isOpen = true;
    }

    function close() {
      if (!isOpen) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      isOpen = false;
      img.src = '';
    }

    function step(offset: number) {
      if (gallery.length <= 1) return;
      currentIndex = (currentIndex + offset + gallery.length) % gallery.length;
      updateDisplay();
    }

    function updateDisplay() {
      const item = gallery[currentIndex];
      if (!item) return;

      img.src = item.src;
      img.alt = item.alt || item.caption;
      captionEl.textContent = item.caption;
      counterEl.textContent = `${currentIndex + 1} / ${gallery.length}`;

      if (gallery.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
      } else {
        if (prevBtn) prevBtn.style.display = 'flex';
        if (nextBtn) nextBtn.style.display = 'flex';
      }
    }

    // Modal click delegates
    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const actionEl = target.closest('[data-action]');
      if (!actionEl) return;
      const action = actionEl.getAttribute('data-action');
      if (action === 'close') close();
      else if (action === 'prev') step(-1);
      else if (action === 'next') step(1);
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
    });

    // Touch swipe gestures on mobile
    let touchStartX = 0;
    let touchStartY = 0;
    modal.addEventListener('touchstart', (e) => {
      if (e.changedTouches.length > 0) {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }
    }, { passive: true });

    modal.addEventListener('touchend', (e) => {
      if (e.changedTouches.length > 0) {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) step(1); // Swipe left -> Next
          else step(-1); // Swipe right -> Prev
        }
      }
    }, { passive: true });

    refreshTriggers();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLightbox);
  } else {
    setupLightbox();
  }
  document.addEventListener('astro:page-load', setupLightbox);
</script>

<style>
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    outline: none;
    animation: lbFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lbFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 14, 20, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: zoom-out;
  }

  .lightbox-dialog-body {
    position: relative;
    z-index: 10001;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(94vw, 1300px);
    max-height: 92vh;
    pointer-events: none;
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 80vh;
    pointer-events: auto;
  }

  .lightbox-main-img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    border: 1px solid var(--edge);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
    background: #0d1117;
    animation: lbScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lbScaleIn {
    from {
      transform: scale(0.96);
    }
    to {
      transform: scale(1);
    }
  }

  .lightbox-info-bar {
    position: relative;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    margin-top: 0.85rem;
    padding: 0.65rem 1.15rem;
    background: rgba(22, 27, 34, 0.88);
    border: 1px solid var(--edge);
    border-radius: 8px;
    backdrop-filter: blur(6px);
  }

  .lightbox-caption-text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
  }

  .lightbox-counter-badge {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    padding: 0.15rem 0.55rem;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    border: 1px solid var(--edge);
  }

  .lightbox-nav-btn {
    position: absolute;
    z-index: 10002;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(26, 32, 44, 0.85);
    border: 1px solid var(--edge);
    color: var(--text);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.15s, transform 0.15s, border-color 0.15s, color 0.15s;
    user-select: none;
  }

  .lightbox-nav-btn:hover {
    background: var(--panel-raised);
    border-color: var(--accent);
    color: var(--accent);
    transform: scale(1.08);
  }

  .lightbox-close {
    top: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
  }

  .lightbox-prev {
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev:hover {
    transform: translateY(-50%) scale(1.08);
  }

  .lightbox-next {
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next:hover {
    transform: translateY(-50%) scale(1.08);
  }

  @media (max-width: 768px) {
    .lightbox-modal {
      padding: 0.75rem;
    }
    .lightbox-prev {
      left: 0.5rem;
      width: 42px;
      height: 42px;
    }
    .lightbox-next {
      right: 0.5rem;
      width: 42px;
      height: 42px;
    }
    .lightbox-close {
      top: 0.75rem;
      right: 0.75rem;
      width: 38px;
      height: 38px;
    }
    .lightbox-info-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>
