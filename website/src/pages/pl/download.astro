---
import Layout from '../../layouts/Layout.astro';
import Screenshot from '../../components/Screenshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/DavIT-Futures/Civ_1_5_Remastered/releases';
const latestWindows = `${releases}/latest/download/Civ_1_5_Remastered-win-x64.zip`;
const latestLinux = `${releases}/latest/download/Civ_1_5_Remastered-linux-x64.tar.gz`;
const latestMacArm = `${releases}/latest/download/Civ_1_5_Remastered-macos-arm64.tar.gz`;
const latestMacIntel = `${releases}/latest/download/Civ_1_5_Remastered-macos-x64.tar.gz`;
const search = 'https://www.google.com/search?q=CIVILIZATION.zip+Civilization+1991+DOS+archive.org';

const versions = ['1.0.0', '1.1.0', '1.2.0', '1.3.0', '1.4.0', '1.5.0'];

const changes = [
  { since: '1.0.0', id: 'unit-health', text: 'Paski zdrowia jednostek, bitwy w rundach' },
  { since: '1.0.0', id: 'elite-units', text: 'Jednostki elitarne' },
  { since: '1.0.0', id: 'healing', text: 'Leczenie jednostek w każdej turze' },
  { since: '1.0.0', id: 'railroads', text: 'Koleje wewnątrz miast' },
  { since: '1.0.0', id: 'goto-railroads', text: 'GoTo po torach kolejowych' },
  { since: '1.0.0', id: 'saves', text: 'Sloty zapisu i autozapisy' },
  { since: '1.0.0', id: 'load-game', text: 'Opcja Load Game bezpośrednio w menu gry' },
  { since: '1.0.0', id: 'help-key', text: 'Skrót Alt+H zawsze wyświetla pomoc' },
  { since: '1.0.0', id: 'demographics', text: 'Naprawione liczniki demografii w dużych imperiach' },
  { since: '1.0.0', id: 'pillage', text: 'Plądrowanie przy obcych miastach nie psuje pamięci' },
  { since: '1.0.0', id: 'random-numbers', text: 'Nowoczesny generator liczb losowych' },
  { since: '1.0.0', id: 'smaller-fixes', text: 'Płynne przejścia grafik (rozpuszczanie): logo, budynki, pałac, powtórka' },
  { since: '1.0.0', id: 'smaller-fixes', text: 'Zmaksymalizowane okno, F11 dla pełnego ekranu' },
  { since: '1.1.0', id: 'wonders', text: 'Cuda świata nigdy się nie przedawniają' },
  { since: '1.1.0', id: 'boarding', text: 'Wejście na statek kończy ruch jednostki' },
  { since: '1.1.0', id: 'missing-files', text: 'Ekran pomocy przy braku plików oryginalnej gry' },
  { since: '1.2.0', id: 'upgrades', text: 'Ulepszanie jednostek za złoto, także w Civilopedii' },
  { since: '1.2.0', id: 'smaller-fixes', text: 'Mniejszy rozmiar pobierania: 20 MB zamiast 46 MB' },
  { since: '1.3.0', id: 'city-projects', text: 'Ciągłe projekty miejskie: Bogactwo, Badania i Żywność (50% konwersji tarcz)' },
  { since: '1.3.0', id: 'city-projects', text: 'Liczbowe wskaźniki surowców w oknie miasta na środku każdego surowca' },
  { since: '1.3.0', id: 'city-projects', text: 'Podział surowców żywności i produkcji na zajęte i wolne (np. 20/2, 3/8)' },
  { since: '1.3.0', id: 'sound-upgrade', url: `${base}/pl/sound/`, text: 'Naprawiony i ulepszony dźwięk (PC Speaker, Tandy 1000, AdLib OPL2, Roland MT-32, General MIDI) — zobacz dedykowaną stronę dźwięku' },
  { since: '1.4.0', id: 'saves', text: 'Zwiększenie liczby slotów zapisu do 20 (CIVIL0–CIVIL19)' },
  { since: '1.4.0', id: 'sound-upgrade', url: `${base}/pl/sound/`, text: 'Menu Sound w oknie gry do zmiany trybu dźwięku w locie' },
  { since: '1.4.0', id: 'advisor-reports', text: 'Bogatsze raporty doradców: tempo nauki, finanse handlu i zysk netto, podsumowanie imperium' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'DLC: Polska (Kazimierz Wielki) i Japonia (Tokugawa) na szczycie menu wyboru nacji' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Autentyczne hymny narodowe MIDI (Mazurek Dąbrowskiego i Kimigayo) we wszystkich 8 trybach dźwięku' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Biało-czerwone, 2-pikselowe pasy na mundurach i proporcach miast dla Polski i Japonii' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Wierne pozycje startowe na mapie Ziemi i dedykowane bazy 48 miast dla obu nacji' },
  { since: '1.5.0', id: 'sound-upgrade', url: `${base}/pl/sound/`, text: 'Wyróżnienie najlepszych trybów na ekranie wyboru dźwięku ("best -> 5", "best -> 7")' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Poprawiona muzyka wojenna po odrzuceniu pokoju w dyplomacji i zdobyciu miasta' },
];

const included = (since: string, version: string) => versions.indexOf(version) >= versions.indexOf(since);
---

<Layout
  title="Pobierz"
  description="Pobierz najnowszą wersję Civ 1.5 Remastered dla Windows, Linux i macOS."
  lang="pl"
>
  <h1>Pobierz</h1>
  <p class="lead">Najnowsza wersja dla systemów Windows, Linux oraz macOS (64-bit). Samodzielne paczki — nie wymagają instalowania środowiska .NET ani DOSBoksa.</p>

  <div class="download-grid">
    <a class="button primary download-card" href={latestWindows}>
      <span class="os-icon">🪟</span>
      <span class="os-title">Windows</span>
      <span class="os-meta">64-bit (.zip)</span>
    </a>
    <a class="button download-card" href={latestLinux}>
      <span class="os-icon">🐧</span>
      <span class="os-title">Linux</span>
      <span class="os-meta">x64 (.tar.gz)</span>
    </a>
    <a class="button download-card" href={latestMacArm}>
      <span class="os-icon">🍏</span>
      <span class="os-title">macOS Apple Silicon</span>
      <span class="os-meta">ARM64 (.tar.gz)</span>
    </a>
    <a class="button download-card" href={latestMacIntel}>
      <span class="os-icon">🍏</span>
      <span class="os-title">macOS Intel</span>
      <span class="os-meta">x64 (.tar.gz)</span>
    </a>
  </div>

  <div class="actions">
    <a class="button" href={`${releases}/latest`}>Informacje o wydaniu</a>
    <a class="button" href={releases}>Wszystkie wersje</a>
  </div>

  <h2>Instrukcja uruchomienia</h2>
  <ol class="plain-list">
    <li>Rozpakuj pobrane archiwum na dysku.</li>
    <li>
      Umieść pliki Civilization 1 dla DOS w folderze o nazwie <code>CIVILIZATION</code> bezpośrednio obok
      <code>Civ_1_5_Remastered.Desktop.exe</code> (lub <code>Civ_1_5_Remastered.Desktop</code> na systemach Linux/macOS), jak na zrzucie ekranu poniżej. Folder <code>CIVILIZATION</code> to
      oryginalna gra z 1991 roku; nie jest częścią tego repozytorium, ale z łatwością znajdziesz kopię w sieci, na przykład na
      Internet Archive: <a href={search}>wyszukaj "CIVILIZATION.zip Civilization 1991 DOS"</a>.
    </li>
    <li>Uruchom <code>Civ_1_5_Remastered.Desktop.exe</code> (lub <code>./Civ_1_5_Remastered.Desktop</code> na Linux/macOS).</li>
  </ol>

  <Screenshot
    name="game-folder"
    image="game-folder.png"
    caption="Rozpakowane wydanie: folder CIVILIZATION z plikami oryginalnej gry znajduje się obok Civ_1_5_Remastered.Desktop.exe."
  />

  <p>
    Zapisane stany gry przechowywane są wewnątrz folderu <code>CIVILIZATION</code>, więc nowa wersja wymaga jedynie wskazania tego samego folderu.
  </p>

  <h2>Historia wersji</h2>
  <p>Zawartość poszczególnych wydań. Kliknij dowolną pozycję, aby przejść do jej opisu na podstronie Co nowego. Etykieta <span class="badge">Nowość</span> oznacza wersję, w której pojawiła się dana zmiana.</p>

  <div class="table-scroll versions">
    <table>
      <thead>
        <tr>
          <th>Zmiana</th>
          {versions.map((version) => <th class="version-column"><a href={`${releases}/tag/v${version}`}>{version}</a></th>)}
        </tr>
      </thead>
      <tbody>
        {
          changes.map((change) => (
            <tr>
              <td>
                <a href={change.url ?? `${base}/pl/whats-new/#${change.id}`} class="change-link">
                  {change.text}
                </a>
              </td>
              {versions.map((version) => (
                <td class="version-column">
                  {change.since === version ? (
                    <span class="badge">Nowość</span>
                  ) : included(change.since, version) ? (
                    <span class="included" aria-label="obecne">✓</span>
                  ) : (
                    <span class="missing" aria-label="brak">–</span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>

<style>
  .download-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 1rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1.25;
  }

  .download-card .os-icon {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .download-card .os-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .download-card .os-meta {
    font-size: 0.8rem;
    opacity: 0.85;
    margin-top: 0.35rem;
    font-weight: 500;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .versions table {
    width: 100%;
    border-collapse: collapse;
  }

  .versions th,
  .versions td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--edge);
    text-align: left;
  }

  .version-column {
    text-align: center !important;
    width: 85px;
  }

  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(217, 180, 90, 0.3);
  }

  .included {
    color: #4ade80;
    font-weight: 700;
  }

  .missing {
    color: var(--muted);
    opacity: 0.4;
  }

  .change-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: rgba(140, 200, 216, 0.4);
    text-underline-offset: 3px;
  }

  .change-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }
</style>
