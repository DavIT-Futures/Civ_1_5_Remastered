---
import Layout from '../layouts/Layout.astro';
import Screenshot from '../components/Screenshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const highlights = [
  { title: 'True Native Multiplatform', text: 'Standalone native builds for Windows, Linux, and macOS (Apple Silicon ARM64 & Intel x64). Zero DOSBox required.' },
  { title: 'DLC: Poland & Japan', text: 'Play as Poles led by Casimir the Great or Japanese led by Tokugawa, with striped uniforms, MIDI anthems, and Earth map locations.' },
  { title: 'Units have health', text: 'Hit points, health bars and battles in rounds. No more Triremes sinking Battleships.' },
  { title: 'Units heal', text: 'Every turn, in cities, fortified on land, or resting near the coast.' },
  { title: 'Railroads that work', text: 'Cities get railroads, and trains keep their moves through them.' },
  { title: 'Saves and autosaves', text: '20 save slots instead of 4, and 20 autosaves, one every turn instead of every 1000 years.' },
  { title: 'Wonders last forever', text: 'No Wonder of the World becomes obsolete any more.' },
  { title: 'Upgrade units', text: 'Turn old units into new ones for gold: Phalanx into Musketeers, Knights into Armor.' },
  { title: 'Fixed demographics', text: 'No more negative numbers in large empires.' },
  { title: 'Better random numbers', text: 'A modern generator instead of the weak one of 1991.' },
];
---

<Layout
  title="Civ 1.5 Remastered"
  description="A C# remaster of Civilization (1991) for DOS: native on Windows, Linux, and macOS with better battles, healing, railroads and fixes."
>
  <section class="hero">
    <div>
      <img src={`${base}/screens/civ1-title.png`} alt="Sid Meier's Civilization (1991)" class="hero-title-img" style="max-width: 100%; height: auto; margin-bottom: 1rem; border-radius: 8px; image-rendering: pixelated;" />
      <h1>Civ 1.5 <span>Remastered</span></h1>
      <div class="hero-platforms-bar">
        <span class="platform-chip platform-win">
          <svg class="os-icon" viewBox="0 0 88 88" width="16" height="16" fill="currentColor"><path d="M0 12.402l35.687-4.86.016 34.423-35.67.203zm35.67 33.529l.028 34.453L.028 75.48.016 45.7zm4.326-39.027L87.914 0v41.527l-47.918.376zm47.918 43.947v41.653L39.996 81.08V46.046z"/></svg>
          Windows
        </span>
        <span class="platform-chip platform-linux">
          <svg class="os-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12.001 0c-3.1 0-5.617 2.518-5.617 5.617 0 .546.078 1.074.226 1.574C5.166 7.828 4.25 9.176 4.25 10.74c0 1.25.59 2.36 1.508 3.08-.106.4-.168.82-.168 1.255 0 3.238 2.87 5.86 6.41 5.86s6.41-2.622 6.41-5.86c0-.435-.062-.855-.168-1.255.918-.72 1.508-1.83 1.508-3.08 0-1.564-.916-2.912-2.36-3.55.148-.5.226-1.027.226-1.573C17.618 2.518 15.101 0 12.001 0zm0 1.5c2.274 0 4.117 1.843 4.117 4.117 0 .49-.086.958-.242 1.39l-.16.44.444.153c1.176.406 1.957 1.52 1.957 2.766 0 .97-.478 1.86-1.26 2.35l-.41.255.14.465c.105.352.164.72.164 1.1c0 2.41-2.146 4.36-4.75 4.36s-4.75-1.95-4.75-4.36c0-.38.06-.748.164-1.1l.14-.465-.41-.255c-.782-.49-1.26-1.38-1.26-2.35 0-1.246.78-2.36 1.957-2.766l.444-.153-.16-.44c-.156-.432-.242-.9-.242-1.39C7.884 3.343 9.727 1.5 12.001 1.5z"/></svg>
          Linux
        </span>
        <span class="platform-chip platform-mac">
          <svg class="os-icon" viewBox="0 0 170 170" width="16" height="16" fill="currentColor"><path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.69-7.85-12-14.44-6.19-9.46-11.16-20.08-14.92-31.85-3.76-11.77-5.64-22.9-5.64-33.39 0-13.59 3.42-25.04 10.24-34.34 6.83-9.31 15.47-14.07 25.94-14.28 5.33 0 11.16 1.41 17.48 4.23 6.32 2.83 10.12 4.34 11.38 4.54 1.83-.4 5.92-2.02 12.27-4.85 6.35-2.83 12.09-4.14 17.22-3.93 9.57.43 17.65 3.86 24.23 10.29 6.58 6.43 10.83 14.12 12.74 23.08-8.28 5.01-12.35 11.87-12.21 20.59.14 7.62 3.17 14.08 9.09 19.38 5.92 5.3 12.92 8.32 21 9.06-2.28 6.85-5.01 13.88-8.18 21.09zM119.22 31.84c0-7.39 2.65-14.38 7.95-20.97 5.3-6.59 11.89-10.45 19.77-11.58.22 1.3.33 2.49.33 3.58 0 7.39-2.73 14.33-8.18 20.82-5.45 6.49-12.08 10.35-19.87 11.58v-3.43z"/></svg>
          macOS
        </span>
        <span class="platform-chip platform-native">
          ⚡ 100% Native • Zero DOSBox
        </span>
      </div>
      <p class="lead">
        Civilization from 1991, running natively across Windows, Linux, and macOS. The same game you remember, with the rough edges fixed
        and modern cross-platform support — zero DOSBox required!
      </p>
      <div class="actions">
        <a class="button primary" href={`${base}/download/`}>Download</a>
        <a class="button" href={`${base}/whats-new/`}>What's new</a>
      </div>
    </div>
    <Screenshot name="overview" caption="Cities connected by railroads." image="overview.png" />
  </section>

  <h2>Highlights</h2>
  <ul class="highlights">
    {
      highlights.map((item) => (
        <li>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>
  <p><a href={`${base}/whats-new/`}>Everything that changed →</a></p>

  <h2>What it is</h2>
  <p>
    The original <code>CIV.EXE</code> was translated function by function into C#. The game logic is the original
    one, so the game plays like it did in 1991, but it runs as a modern, high-performance cross-platform application in its own window on Windows, Linux, and macOS, with the
    original AdLib and Roland music.
  </p>
  <p>
    You need your own copy of Civilization for DOS: the game reads its pictures, texts and data from the original
    files, which are not part of this project.
  </p>
</Layout>
