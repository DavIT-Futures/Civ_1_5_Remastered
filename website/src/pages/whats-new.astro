---
import Layout from '../layouts/Layout.astro';
import Feature from '../components/Feature.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/DavIT-Futures/Civ_1_5_Remastered/releases';
const latestWindows = `${releases}/latest/download/Civ_1_5_Remastered-win-x64.zip`;
const latestLinux = `${releases}/latest/download/Civ_1_5_Remastered-linux-x64.tar.gz`;
---

<Layout title="What's new" description="The changes of Civ 1.5 Remastered: DLC with Poland and Japan, unit health, city projects, resource badges, railroads, Alt+H notes, 8 sound modes, saves, Load Game, unit upgrades, and bug fixes.">
  <h1>What's new</h1>
  <section class="dlc-showcase" id="dlc-poland-japan">
    <div class="dlc-header">
      <span class="dlc-badge">DLC</span>
      <h2>DLC: Poland and Japan (Polish, Japanese)</h2>
    </div>

    <!-- Leaders and anthems: Polish anthem to the left of Casimir, Japanese anthem to the right of Tokugawa -->
    <div class="dlc-media-row">
      <!-- Polish Anthem -->
      <div class="anthem-card dlc-poland-anthem">
        <div class="anthem-meta">
          <span class="anthem-flag" aria-hidden="true">🇵🇱</span>
          <div>
            <strong>Poland Anthem</strong>
            <span class="anthem-subtitle">Mazurek Dąbrowskiego (General MIDI)</span>
          </div>
        </div>
        <div class="anthem-playback">
          <audio controls preload="none" class="anthem-audio" src={`${base}/audio/poland_anthem.wav`}></audio>
          <a class="button small ghost" href={`${base}/audio/poland.mid`} download="poland.mid" title="Download raw MIDI file">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            .MID
          </a>
        </div>
      </div>

      <!-- Casimir Portrait -->
      <figure class="dlc-photo-card dlc-casimir">
        <div class="screenshot-wrap" role="button" tabindex="0" title="Click to enlarge" data-lightbox-trigger data-src={`${base}/screens/casimir.png`} data-caption="King Casimir III the Great (Kazimierz Wielki) — Leader of the Polish civilization.">
          <img src={`${base}/screens/casimir.png`} alt="King Casimir III the Great (Kazimierz Wielki)" loading="lazy" width="240" height="320" />
          <span class="screenshot-zoom-hint" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </span>
        </div>
        <figcaption>King Casimir III the Great (Kazimierz Wielki) — Poland</figcaption>
      </figure>

      <!-- Tokugawa Portrait -->
      <figure class="dlc-photo-card dlc-tokugawa">
        <div class="screenshot-wrap" role="button" tabindex="0" title="Click to enlarge" data-lightbox-trigger data-src={`${base}/screens/tokugawa.png`} data-caption="Shogun Tokugawa Ieyasu — Leader of the Japanese civilization.">
          <img src={`${base}/screens/tokugawa.png`} alt="Shogun Tokugawa Ieyasu" loading="lazy" width="240" height="320" />
          <span class="screenshot-zoom-hint" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </span>
        </div>
        <figcaption>Shogun Tokugawa Ieyasu — Japan</figcaption>
      </figure>

      <!-- Japanese Anthem -->
      <div class="anthem-card dlc-japan-anthem">
        <div class="anthem-meta">
          <span class="anthem-flag" aria-hidden="true">🇯🇵</span>
          <div>
            <strong>Japan Anthem</strong>
            <span class="anthem-subtitle">Kimigayo (General MIDI)</span>
          </div>
        </div>
        <div class="anthem-playback">
          <audio controls preload="none" class="anthem-audio" src={`${base}/audio/japan_anthem.wav`}></audio>
          <a class="button small ghost" href={`${base}/audio/japan.mid`} download="japan.mid" title="Download raw MIDI file">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            .MID
          </a>
        </div>
      </div>
    </div>

    <!-- Full description below -->
    <div class="dlc-description">
      <ul class="plain-list">
        <li><strong>White & Red Regalia:</strong> Iconic striped 2-pixel red-and-white uniforms on unit sprites and city banners.</li>
        <li><strong>Authentic MIDI Anthems:</strong> Studio arrangements of <em>Mazurek Dąbrowskiego</em> & <em>Kimigayo</em> across all 8 sound drivers.</li>
        <li><strong>Earth Map Start:</strong> Historically accurate coordinates for Warsaw and Honshu on the Earth scenario.</li>
        <li><strong>48 Cities Each:</strong> Historically researched city lists for both nations (Warsaw, Kyoto, Kraków, Tokyo...).</li>
      </ul>
    </div>
  </section>

  <section class="feature" id="native-multiplatform">
    <div class="feature-text">
      <h3>True Native Multiplatform</h3>
      <p>
        Civilization (1991) running 100% natively on modern desktop platforms. The entire game logic and renderer have been
        rebuilt in modern C# as standalone, self-contained 64-bit binaries for Windows, Linux, and macOS.
      </p>
      <p>
        Zero DOSBox, zero emulation overhead, and no external runtimes required. Just download the archive for your operating system,
        extract, and enjoy original AdLib and Roland music with pixel-perfect integer scaling.
      </p>
      <div class="feature-downloads-grid">
        <a class="download-mini-chip chip-win" href={latestWindows} title="Download for Windows x64 (.zip)">
          <svg class="os-icon" viewBox="0 0 88 88" width="18" height="18" fill="currentColor"><path d="M0 12.402l35.687-4.86.016 34.423-35.67.203zm35.67 33.529l.028 34.453L.028 75.48.016 45.7zm4.326-39.027L87.914 0v41.527l-47.918.376zm47.918 43.947v41.653L39.996 81.08V46.046z"/></svg>
          <span><strong>Windows</strong> (.zip)</span>
        </a>
