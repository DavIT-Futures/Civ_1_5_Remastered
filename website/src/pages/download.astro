---
import Layout from '../layouts/Layout.astro';
import Screenshot from '../components/Screenshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/DavIT-Futures/Civ_1_5_Remastered/releases';
const latestWindows = `${releases}/latest/download/Civ_1_5_Remastered-win-x64.zip`;
const latestLinux = `${releases}/latest/download/Civ_1_5_Remastered-linux-x64.tar.gz`;
const latestMacArm = `${releases}/latest/download/Civ_1_5_Remastered-macos-arm64.tar.gz`;
const latestMacIntel = `${releases}/latest/download/Civ_1_5_Remastered-macos-x64.tar.gz`;
const search = 'https://www.google.com/search?q=CIVILIZATION.zip+Civilization+1991+DOS+archive.org';

const versions = ['1.0.0', '1.1.0', '1.2.0', '1.3.0', '1.4.0', '1.5.0', '1.6.0', '1.7.0', '1.7.1', '1.7.2', '1.7.3'];

const changes = [
  { since: '1.0.0', id: 'unit-health', text: 'Units have health, battles in rounds' },
  { since: '1.0.0', id: 'elite-units', text: 'Elite units' },
  { since: '1.0.0', id: 'healing', text: 'Healing every turn' },
  { since: '1.0.0', id: 'railroads', text: 'Railroads in cities' },
  { since: '1.0.0', id: 'goto-railroads', text: 'GoTo on railroads' },
  { since: '1.0.0', id: 'saves', text: 'Manual save slots and autosaves' },
  { since: '1.0.0', id: 'load-game', text: 'Load Game in the game menu' },
  { since: '1.0.0', id: 'help-key', text: 'Alt+H always helps' },
  { since: '1.0.0', id: 'demographics', text: 'Demographics fixed in large empires' },
  { since: '1.0.0', id: 'pillage', text: 'Pillage fixed next to foreign cities' },
  { since: '1.0.0', id: 'random-numbers', text: 'Better random numbers' },
  { since: '1.0.0', id: 'smaller-fixes', text: 'Dissolving pictures: title logo, new buildings, palace, replay' },
  { since: '1.0.0', id: 'smaller-fixes', text: 'Maximized window, F11 for full screen' },
  { since: '1.1.0', id: 'wonders', text: 'Wonders never become obsolete' },
  { since: '1.1.0', id: 'boarding', text: 'Boarding a ship ends the moves' },
  { since: '1.1.0', id: 'missing-files', text: 'Help when the game files are missing' },
  { since: '1.2.0', id: 'upgrades', text: 'Upgrade units for gold, also in the Civilopedia' },
  { since: '1.2.0', id: 'smaller-fixes', text: 'Smaller download: 20 MB instead of 46 MB' },
  { since: '1.3.0', id: 'city-projects', text: 'Continuous city projects: Wealth, Research, and Food (50% shields conversion)' },
  { since: '1.3.0', id: 'city-projects', text: 'Resource quantity badges centered on city screen resource icons' },
  { since: '1.3.0', id: 'city-projects', text: 'Occupied vs free yield split for food and shields (e.g. 20/2, 3/8)' },
  { since: '1.3.0', id: 'sound-upgrade', url: `${base}/sound/`, text: 'Fixed and upgraded audio support (PC Speaker, Tandy 1000, AdLib, Roland MT-32, General MIDI) — see the Sound page for more details' },
  { since: '1.4.0', id: 'saves', text: 'Expanded manual saves to 20 slots (CIVIL0–CIVIL19)' },
  { since: '1.4.0', id: 'sound-upgrade', url: `${base}/sound/`, text: 'In-game Sound menu to switch audio modes on the fly' },
  { since: '1.4.0', id: 'advisor-reports', text: 'Richer advisor reports: science pace, trade report financials & net cashflow, empire city totals' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'DLC: Poland (Casimir the Great) and Japan (Tokugawa) at top of tribe selection' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Authentic MIDI national anthems (Mazurek Dąbrowskiego & Kimigayo) across all 8 sound drivers' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Red-and-white 2-pixel striped uniforms and city banners for Poland and Japan' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'True Earth map starting positions & 48 authentic cities each' },
  { since: '1.5.0', id: 'sound-upgrade', url: `${base}/sound/`, text: 'Sound selection screen highlights top choices ("best -> 5", "best -> 7")' },
  { since: '1.5.0', id: 'dlc-poland-japan', text: 'Diplomacy rejection and war declaration audio logic fixes' },
  { since: '1.6.0', id: 'diplomacy-advisor', text: 'Diplomacy rework: vendettas expire, reparations, peace counter, treaties protect for 16 turns' },
  { since: '1.6.0', id: 'diplomacy-advisor', text: 'War Advisor (F12): mood, reasons of hostility, forecast of the next audience, T to talk to a ruler' },
  { since: '1.6.0', id: 'production-queue', text: 'Production queue with the QUE button; wider production box in the city screen' },
  { since: '1.6.0', id: 'automated-settlers', text: 'Automated settlers: 5 modes, all cities or one city, A on the icon, smart work order, jungle and swamp' },
  { since: '1.6.0', id: 'goto-pathfinding', text: 'Fastest GoTo over the whole map, sticks to railroads and roads' },
  { since: '1.6.0', id: 'stack-combat', text: 'Fairer stack combat: only the defender dies, the rest lose 2 hit points' },
  { since: '1.6.0', id: 'elite-units', text: 'Elite rank shown (E), elite units roll two lost combat rounds again, square health pips' },
  { since: '1.6.0', id: 'civilian-ships', text: 'Civilian ships (Trireme, Sail, Transport) cause no unhappiness; Frigate is a 50-shield warship; new ship upgrade chains' },
  { since: '1.6.0', id: 'civilopedia-entries', text: 'New Civilopedia entries Diplomacy, War, Automation; Alt+H lists the new keys' },
  { since: '1.6.0', id: 'extras-file', text: 'Queues and automation saved in a compatible .EXT file' },
  { since: '1.7.0', id: 'disorder-warning', text: 'Civil disorder warning before the end of turn, with automatic entertainers' },
  { since: '1.7.0', id: 'sentry-alarm', text: 'Sentried units wake up when an enemy stands next to them' },
  { since: '1.7.0', id: 'courthouse', text: 'Courthouse removes three quarters of the corruption' },
  { since: '1.7.0', id: 'senate', text: 'The Senate allows war against a civilization with a vendetta or a plan to break the peace' },
  { since: '1.7.0', id: 'ai-expansion', text: 'Computer expansion measured in headless games: 21-60% more cities' },
  { since: '1.7.0', id: 'city-rules', text: 'New Civilopedia entry City Rules' },
  { since: '1.7.1', id: 'larger-map', text: 'Larger map window: View → Map shows up to 50×36 tiles (4× more map at 30×24)' },
  { since: '1.7.1', id: 'larger-map', text: 'Screens, messages and the list of units are drawn centred over the larger map' },
  { since: '1.7.1', id: 'larger-map', text: 'Fixes for the larger map: Load Game, Save Game, new buildings, audiences, unit list' },
  { since: '1.7.2', id: 'leader-portraits', text: 'Own portraits of Casimir and Tokugawa in audiences' },
  { since: '1.7.2', id: 'leader-portraits', text: 'Casimir dresses for the scenery: 7 outfits by government and era' },
  { since: '1.7.3', id: 'leader-portraits', text: 'The computer plays Poland in every game you do not play it' },
  { since: '1.7.3', id: 'leader-portraits', text: 'A destroyed Poland comes back once as Japan' },
];

const included = (since: string, version: string) => versions.indexOf(version) >= versions.indexOf(since);
---

<Layout title="Download" description="Download the latest Civ 1.5 Remastered for Windows, Linux, and macOS.">
  <h1>Download</h1>
  <p class="lead">The latest version for Windows, Linux, and macOS (64-bit). Standalone packages — no .NET runtime and no DOSBox needed.</p>

  <div class="download-grid">
    <a class="button primary download-card" href={latestWindows}>
      <span class="os-icon">🪟</span>
      <span class="os-title">Windows</span>
      <span class="os-meta">64-bit (.zip)</span>
    </a>
    <a class="button download-card" href={latestLinux}>
      <span class="os-icon">🐧</span>
      <span class="os-title">Linux</span>
      <span class="os-meta">x64 (.tar.gz)</span>
    </a>
    <a class="button download-card" href={latestMacArm}>
      <span class="os-icon">🍏</span>
      <span class="os-title">macOS Apple Silicon</span>
      <span class="os-meta">ARM64 (.tar.gz)</span>
    </a>
    <a class="button download-card" href={latestMacIntel}>
      <span class="os-icon">🍏</span>
      <span class="os-title">macOS Intel</span>
      <span class="os-meta">x64 (.tar.gz)</span>
    </a>
  </div>

  <div class="actions">
    <a class="button" href={`${releases}/latest`}>Release notes</a>
    <a class="button" href={releases}>All versions</a>
  </div>

  <h2>Set it up</h2>
  <ol class="plain-list">
    <li>Unpack the downloaded archive.</li>
    <li>
      Put the files of Civilization 1 for DOS in a folder named <code>CIVILIZATION</code> next to
      <code>Civ_1_5_Remastered.Desktop.exe</code> (or <code>Civ_1_5_Remastered.Desktop</code> on Linux/macOS), as in the picture. The <code>CIVILIZATION</code> folder is the
      original game from 1991; it is not part of this project, but it is easy to find online, for example on the
      Internet Archive: <a href={search}>search for "CIVILIZATION.zip Civilization 1991 DOS"</a>.
    </li>
    <li>Run <code>Civ_1_5_Remastered.Desktop.exe</code> (or <code>./Civ_1_5_Remastered.Desktop</code> on Linux/macOS).</li>
  </ol>

  <Screenshot
    name="game-folder"
    image="game-folder.png"
    caption="The unpacked download: the CIVILIZATION folder with the original game sits next to Civ_1_5_Remastered.Desktop.exe."
  />

  <p>
    Saved games stay in the <code>CIVILIZATION</code> folder, so a new version only needs the same folder next to it.
  </p>

  <h2>Versions</h2>
  <p>What each version has. Click any item to jump to its description in What's new. <span class="badge">New</span> marks the version a change came in.</p>

  <div class="table-scroll versions">
    <table>
      <thead>
        <tr>
          <th>Change</th>
          {versions.map((version) => <th class="version-column"><a href={`${releases}/tag/v${version}`}>{version}</a></th>)}
        </tr>
      </thead>
      <tbody>
        {
          changes.map((change) => (
            <tr>
              <td>
                <a href={change.url ?? `${base}/whats-new/#${change.id}`} class="change-link">
                  {change.text}
                </a>
              </td>
              {versions.map((version) => (
                <td class="version-column">
                  {change.since === version ? (
                    <span class="badge">New</span>
                  ) : included(change.since, version) ? (
                    <span class="included" aria-label="included">✓</span>
                  ) : (
                    <span class="missing" aria-label="not included">–</span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>

<style>
  .download-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 1rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1.25;
  }

  .download-card .os-icon {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .download-card .os-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .download-card .os-meta {
    font-size: 0.8rem;
    opacity: 0.85;
    margin-top: 0.35rem;
    font-weight: 500;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .versions table {
    width: 100%;
    border-collapse: collapse;
  }

  .versions th,
  .versions td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--edge);
    text-align: left;
  }

  .version-column {
    text-align: center !important;
    width: 85px;
  }

  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(217, 180, 90, 0.3);
  }

  .included {
    color: #4ade80;
    font-weight: 700;
  }

  .missing {
    color: var(--muted);
    opacity: 0.4;
  }

  .change-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: rgba(140, 200, 216, 0.4);
    text-underline-offset: 3px;
  }

  .change-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }
</style>
